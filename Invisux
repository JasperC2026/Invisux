emoty_trash() {
    TRASH_FILES="$HOME/.local/share/Trash/files"
    TRASH_INFO="$HOME/.local/share/Trash/info"

    local file_count
    file_count=$(find "$TRASH_FILES" -mindepth 1 2>/dev/null | wc -l)

    if [[ $file_count -eq 0 ]]; then
        echo "[i] Trash is already empty."
        return 0
    fi

    echo "[i] Found $file_count item(s) in Trash."

    read -rp "Securely delete all trash? (y/n): " confirm

    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        animation_begin

        # Shred files: 3 passes, zero out on final pass, then remove
        find "$TRASH_FILES" -type f -print0 2>/dev/null \
            | xargs -0 -r shred -z -n 3 --remove 2>/dev/null

        # Remove leftover empty directories
        find "$TRASH_FILES" -mindepth 1 -depth -type d -empty -delete 2>/dev/null

        # Shred and remove the corresponding .trashinfo metadata files
        find "$TRASH_INFO" -type f -print0 2>/dev/null \
            | xargs -0 -r shred -z -n 3 --remove 2>/dev/null

        animation_end
    else
        echo "Cancelled"
        return 0
    fi

    local remaining
    remaining=$(find "$TRASH_FILES" -mindepth 1 2>/dev/null | wc -l)

    if [[ $remaining -eq 0 ]]; then
        echo "Succefully emptied"
    else
        echo "Some items may remain, check manually"
        return 0
    fi
}

delete-file() {
    echo "Select a file to be removed:  "

    file=$(gum file)

    if [[ "$file" == "no file selected" ]]; then
        echo "No file was selected"
        return 0
    fi

    animation_begin

    shred -z -n 3 $file

    shred -u $file

    animation_end
}

remove_metadata() {
    echo "Select a file:    "
    file=$(gum file)

    if [[ "$file" == "no file selected" ]]; then
        echo "No file was selected"
        return 0
    fi

    gum confirm "Edit $file?" && exiftool -all= $file
}

update-apps() {
    options=$(gum choose --no-limit APT Snap Pacman DNF Zypper)

    echo "Are you sure?"
    confirm=$(gum choose yes no)

    case $confirm in
        no)
            return 0
            ;;
    esac

    echo "You selected $(echo "$options" | wc -l) package manager(s)"
    echo ""

    while IFS= read -r choice; do
        echo "Processing selection: $choice"
        
        case "$choice" in
            "APT")
                sudo apt update -y && sudo apt upgrade -y
                ;;
            "Snap")
                sudo snap refresh
                ;;
            "Pacman")
                sudo pacman -Syu --quiet --noconfirm
                ;;
            "DNF")
                sudo dnf upgrade --assumeyes
                ;;
            "Zypper")
                sudo zypper refresh --no-confirm && sudo zypper update --no-confirm
                ;;
        esac
    done <<< "$options"
}


generate-key() {
    gpg --gen-key
} 

delete-key() {
    read -p "Username:  " username

    echo "Enter kind of key:    "
    answer=$(gum choose public private)

    case $answer in
        public)
            gum confirm "Delete key for: $username?" && gpg --delete-key $username 
        ;;
        private)
            gum confirm "Delete key for: $username?" && gpg --delete-secret-key $username
        ;;
    esac
}

import-key() {
    echo "Select a file:    "
    file=$(gum file)

    gpg --import $file
} 

export-key() {
    read -p "Enter your username:   " username
    read -p "Enter file to write to (no extension added):    " file

    gpg --export -a $username $file.key
} 

list-keys() {
    echo "Public:   "
    gpg --list-keys
    echo "Secret:   "
    gpg --list-secret-keys
} 

sign() {
    echo "Select a file:    "
    file=$(gum file)

    gpg --sign $file
}

verify() {
    echo "Select a file:    "
    file=$(gum file)

	gpg --verify $file
}


hash-passwd() {
    local dependencie=openssl
    dependencie_checker

    echo "Choose a password to hash"
    local hash=$(gum input --placeholder "Password" )

    if [[ -z "$hash" ]]; then
        echo "No input provided" >&2
        status=5
        error_check
        return 0
    fi

    echo "Choose a protocol:    "
    local protocol=$(gum choose MD5 SHA256 SHA512 APR1 AIX)

    case $protocol in
        MD5)
        local output=$(openssl passwd -1 $hash)
        ;;
        SHA256)
        local output=$(openssl passwd -5 $hash)
        ;;
        SHA512)
        local output=$(openssl passwd -6 $hash)
        ;;
        APR1)
        local output=$(openssl passwd -apr1 $hash)
        ;;
        AIX)
        local output=$(openssl passwd -aixmd5 $hash)
        ;;
    esac

    echo 
    echo "Your hashed password is: $output"
    echo "Hashed with: $protocol"

    status=$?
    error_check
}

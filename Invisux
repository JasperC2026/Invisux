update-apps() {
    local options=$(gum choose --no-limit APT Flatpak Snap Pacman DNF Yum Zypper)

    echo "Are you sure?"
    local confirm=$(gum choose yes no)

    case $confirm in
        no)
            status=6
            error_check
            return 0
            ;;
    esac

    echo "You selected $(echo "$options" | wc -l) package manager(s)"
    echo ""

    status=0

    while IFS= read -r choice; do
        echo "Processing selection: $choice"

        case "$choice" in
            "Flatpak")
                echo
                sudo flatpak update
            ;;
            "APT")
                echo
                sudo apt update -y && sudo apt upgrade -y
                ;;
            "Snap")
                echo
                sudo snap refresh
                ;;
            "Pacman")
                echo
                sudo pacman -Syu --quiet --noconfirm
                ;;
            "DNF")
                echo
                sudo dnf upgrade --assumeyes
                ;;
            "Yum")
                echo 
                sudo yum update -y
                ;;
            "Zypper")
                echo
                sudo zypper refresh --no-confirm && sudo zypper update --no-confirm
                ;;
        esac

        # Track the worst exit status across all iterations
        local cmd_status=$?
        if (( cmd_status > status )); then
            status=$cmd_status
        fi
    done <<< "$options"

    error_check
}


delete-key() {
    local dependencie=gpg
    dependencie_checker

    read -p "Username:  " username

    echo "Enter kind of key:    "
    local answer=$(gum choose public private)

    case $answer in
        public)
            gum confirm "Delete key for: $username?" && gpg --delete-key $username 
        ;;
        private)
            gum confirm "Delete key for: $username?" && gpg --delete-secret-key $username
        ;;
    esac

    status=$?
    error_check
}


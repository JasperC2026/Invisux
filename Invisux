# Loading animations source
source /usr/local/bin/invisux_loading.sh 

# Shared commands
animation_begin() {
    BLA::start_loading_animation "${BLA_classic_utf8[@]}"
}
animation_end() {
    BLA::stop_loading_animation
}
capture_status() {
    status=$?
}
status_check() {
    if [[ $status -ne 0 ]]; then
        echo -e "$status_negative command failed"
    else
        echo -e "$status_positive command succeeded" 
    fi
}
# Variables
written_in="Bash/shell"
created_on="2 July, 2026"
contributors="JasperC (Lead Developer, Maintainer), and Open Source Community"
license="GPL-3.0"
lines_of_code=$(wc -l < "${BASH_SOURCE[0]}")
type="Pre-Alpha"
version="V0.0.2"
release_date="3-7-2026"
test_date="None"
install_path=$(command -v peregine 2>/dev/null || echo "not installed")
installed=$( [[ "$install_path" != "not installed" ]] && echo "Yes" || echo "No (running from repo)" )
shell_info="$( basename "$SHELL" ) $BASH_VERSION"
platform=$(grep PRETTY_NAME /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '"')
_deps=(gum)
_deps_met=0

for _d in "${_deps[@]}"; do command -v "$_d" &>/dev/null && (( _deps_met++ )); done
deps_status="${_deps_met}/${#_deps[@]} found"
unset _deps _deps_met _d

DIVIDER="───────────────────────────────────────────────────────────────"
status_negative="${RED}[!]${RESET}"
status_positive="${GREEN}[✔]${RESET}"
forward="${GREEN}[➜]${RESET}" 
arrow="➜"

# Colors for ASCII art and use in output messages
RED="\e[31m"
GREEN="\e[32m"
YELLOW="\e[93m"
BLUE="\e[34m"
CYAN="\e[36m"
PURPLE="\e[35m"
ORANGE="\e[38;5;208m"
WHITE="\e[97m"    
BLACK="\e[30m"   
BOLD="\e[1m"
RESET="\e[0m"

# Encryption
encryption_menu() {
    gum_encryption_menu=$(gum choose Explainer General-keys AES GPG Exit)
    
    case $gum_main_option in
        Explainer)
            explainer_encryption
            ;;
        General-keys)
            general-keys
            ;;
        AES)
            aes_menu
            ;;
        GPG)
            echo "test"
            ;;
        Exit)
            return 0
            ;;
    esac
}

explainer_encryption() {
}
general-keys() {
    key_size=$(gum choose 128-bit 192-bit 256-bit 512-bit)
    echo "You selected $key_size as your key size"

    animation_begin

    case $key_size in
        128-bit)
        key=$(openssl rand -hex 16)
        ;;
        192-bit)
        key=$(openssl rand -hex 24)
        ;;
        256-bit)
        key=$(openssl rand -hex 32)
        ;;
        512-bit)
        key=$(openssl rand -hex 64)
        ;;
    esac

    capture_status

    status_check

    animation_end

    echo "Here is your key: $key"
}
aes_menu() {
}
gpg_menu() {
}
help () {
    if [[ -z "$1" ]]; then
        _invisux_main_command
        return 0
    fi

    case "$1" in
        *)
            echo -e "${RED}[!] No help entry for '$1'.${RESET}"
            return 1
            ;;
    esac
}

info() {
    local BOLD='\033[1m'
    local RESET='\033[0m'
    local DIM='\033[2m'
    local CLOGO='\033[38;5;255m'   # white  — logo @'s
    local CLABEL='\e[0;35m'         # purple   — info labels
    local CVAL='\033[38;5;250m'    # grey   — info values
    local CSEP='\033[38;5;240m'    # dim    — separators / title version
    
    printf "\n"
    printf "${CLABEL}${BOLD}  Invisux${RESET}\n"
    printf "${DIM}  Linux Privacy Toolkit${RESET}\n"
    printf "${CSEP}  ───────────────────────────────────────${RESET}\n"
    printf "\n"
    printf "  ${CLABEL}${BOLD}%-18s${RESET} ${CVAL}%s${RESET}\n" "Version" "${type} ${version}"
    printf "  ${CLABEL}${BOLD}%-18s${RESET} ${CVAL}%s${RESET}\n" "Language" "${written_in}"
    printf "  ${CLABEL}${BOLD}%-18s${RESET} ${CVAL}%s${RESET}\n" "License" "${license}"
    printf "  ${CLABEL}${BOLD}%-18s${RESET} ${CVAL}%s${RESET}\n" "Created" "${created_on}"
    printf "  ${CLABEL}${BOLD}%-18s${RESET} ${CVAL}%s${RESET}\n" "Release date" "${release_date}"
    printf "  ${CLABEL}${BOLD}%-18s${RESET} ${CVAL}%s${RESET}\n" "Installed" "${installed}"
    printf "  ${CLABEL}${BOLD}%-18s${RESET} ${CVAL}%s${RESET}\n" "Install path" "${install_path}"
    printf "  ${CLABEL}${BOLD}%-18s${RESET} ${CVAL}%s${RESET}\n" "Shell" "${shell_info}"
    printf "  ${CLABEL}${BOLD}%-18s${RESET} ${CVAL}%s${RESET}\n" "Platform" "${platform}"
    printf "\n"
    printf "${CSEP}  ───────────────────────────────────────${RESET}\n"
    printf "\n"
    printf "  ${CLABEL}${BOLD}%-18s${RESET} ${CVAL}%s${RESET}\n" "Dependencies" "${deps_status}"
    printf "\n"
    printf "${CSEP}  ───────────────────────────────────────${RESET}\n"
    printf "\n"
    printf "  ${CLABEL}${BOLD}%-18s${RESET} ${CVAL}%s${RESET}\n" "Lines of code" "${lines_of_code}"
    printf "\n"
    printf "${CSEP}  ───────────────────────────────────────${RESET}\n"
    printf "\n"
    printf "  ${CLABEL}${BOLD}%-18s${RESET} ${CVAL}%s${RESET}\n" "Test date" "${test_date}"
    printf "\n"
    printf "${CSEP}  ───────────────────────────────────────${RESET}\n\n"
}

license() {
    curl https://codeberg.org/JasperC/Invisux/raw/branch/main/LICENSE
}

# Command dispatcher
_INVISUX_COMMANDS=(
    license
    help
)

# Main command
_invisux_main_command() {
    echo -e "${BOLD}${PURPLE}"

    cat << 'EOF' # Banner
IIIII NN   NN VV     VV IIIII  SSSSS  UU   UU XX    XX 
 III  NNN  NN VV     VV  III  SS      UU   UU  XX  XX  
 III  NN N NN  VV   VV   III   SSSSS  UU   UU   XXXX   
 III  NN  NNN   VV VV    III       SS UU   UU  XX  XX  
IIIII NN   NN    VVV    IIIII  SSSSS   UUUUU  XX    XX 
EOF
    
    echo -e "${RESET}                Linux Privacy Toolkit"
    echo "                 Created by: JasperC" 
    sleep 2
    
    gum_main_option=$(gum choose Encryption Info License Exit)
    
    case $gum_main_option in
        Encryption)
            encryption_menu
            ;;
        Info)
            info
            ;;
        License)
            license
            ;;
        Exit)
            return 0
            ;;
    esac
}

# Command handler
    if [[ $# -eq 0 ]]; then
       _invisux_main_command
    elif [[ "$1" == "help" ]]; then
       help "$2"
    elif [[ " ${_INVISUX_COMMANDS[*]} " == *" $1 "* ]]; then
        "$1"
    else
        echo -e "${RED}[!] Unknown command: $1${RESET}"   
        return 1
    fi


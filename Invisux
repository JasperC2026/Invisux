    dependencie_checker

    local text_or_file=$(gum choose file text return "[↩] Return" "➜] Exit")

    case $text_or_file in
        file)
        echo "Enter file:   "
        file=$(gum file)

        if [[ "$file" == "no file selected" ]]; then
            echo "No file was selected"
            status=5
            error_check
            return 0
        fi

        read -p "Enter file to write to (no extension added):    " output_file

        openssl enc -aes-256-cbc -pbkdf2 -d -iter 100000 -salt -in "$file" -out "$output_file.text"

        echo "Unencrypted file:   $output_file.aes" 

        echo "Delete original encrypted file?"
        local delete_choice=$(gum choose yes no)
        case $delete_choice in
            yes)
                shred -u -- "$file"
            ;;
            no)
                return 0
            ;;
        esac
        ;;
        text)
        local text=$(gum write)

        if [[ -z "$text" ]]; then
            echo "No input provided" >&2
            status=5
            error_check
            return 0
        fi

        printf "%s" "$text" | openssl enc -aes-256-cbc -d -pbkdf2 -iter 100000 -a
        ;;
        "[↩] Return")
            aes_decrypt
            ;;
        "➜] Exit")
            return 0
            ;;
    esac

    status=$?
    error_check
}


hash-passwd() {
    echo "Choose a password to hash"
    hash=$(gum input --placeholder "Password" )

    echo "Choose a protocol:    "
    protocol=$(gum choose MD5 SHA256 SHA512 APR1 AIX)

    case $protocol in
        MD5)
        output=$(openssl passwd -1 $hash)
        ;;
        SHA256)
        output=$(openssl passwd -5 $hash)
        ;;
        SHA512)
        output=$(openssl passwd -6 $hash)
        ;;
        APR1)
        output=$(openssl passwd -apr1 $hash)
        ;;
        AIX)
        output=$(openssl passwd -aixmd5 $hash)
        ;;
    esac

    echo 
    echo "Your hashed password is: $output"
    echo "Hashed with: $protocol"
}

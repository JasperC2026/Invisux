empty_trash() {
    local dependencie=shred
    dependencie_checker

    TRASH_FILES="$HOME/.local/share/Trash/files"
    TRASH_INFO="$HOME/.local/share/Trash/info"

    local file_count
    file_count=$(find "$TRASH_FILES" -mindepth 1 2>/dev/null | wc -l)

    if [[ $file_count -eq 0 ]]; then
        echo "[i] Trash is already empty."
        return 0
    fi

    echo "[i] Found $file_count item(s) in Trash."

    read -rp "Securely delete all trash? (y/n): " confirm

    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        animation_begin

        # Shred files (regular files) — 3 passes, zero on final pass, remove
        find "$TRASH_FILES" -type f -print0 2>/dev/null \
        | xargs -0 -r shred -z -n 3 --remove 2>/dev/null

        # Remove symlinks and other non-regular files 
        find "$TRASH_FILES" \( -type l -o -type p -o -type s \) -print0 2>/dev/null \
        | xargs -0 -r rm -f 2>/dev/null

        # Remove the leftover directory tree
        rm -rf -- "$TRASH_FILES"/*/

        # Shred and remove the .trashinfo metadata files
        find "$TRASH_INFO" -type f -print0 2>/dev/null \
        | xargs -0 -r shred -z -n 3 --remove 2>/dev/null

        animation_end
    else
        echo "Cancelled"
        status=6
        error_check
        return 0
    fi

    local remaining
    remaining=$(find "$TRASH_FILES" -mindepth 1 2>/dev/null | wc -l)

    if [[ $remaining -eq 0 ]]; then
        echo "Succefully emptied"
    else
        echo "Some items may remain, check manually"
        status=1
        error_check
        
        echo "Want to retry?"
        gum confirm && invisux empty_trash
        return 0
    fi

    status=$?
    error_check
}

empty_trash--s() {
    local dependencie=shred
    dependencie_checker

    TRASH_FILES="$HOME/.local/share/Trash/files"
    TRASH_INFO="$HOME/.local/share/Trash/info"


explainer_encryption() {
    cat << EOF
In the modern world encrypting your data and communication is key to ensure a private and secure world. In that set of mind we designed this encryption part of the toolbox. 

Parts included:
- general-keys
- AES
- GPG

General Keys :
General keys is a command to generate a key for cryptographic purposes.

AES:
AES is a menu to encrypt files / texts with the Advanced Encryption Standard protocol, it features two options for an 256-bit key or an 128-bit key. 256-bit is considered more secure and quantum resistant but 128-bit is faster and reasonably still secure.

Dependencie: openssl
GPG:
GPG is a menu to generate and delete keys, import/export keys, to list, sign and verify keys. It uses the Gnu Privacy Guard implementation of OpenPGP.

Dependencie: gpg
EOF
}
keys() {
    key_size=$(gum choose 128-bit 192-bit 256-bit 512-bit)
    echo "You selected $key_size as your key size"

    animation_begin

    case $key_size in
        128-bit)
            key=$(openssl rand -hex 16)
        ;;
        192-bit)
            key=$(openssl rand -hex 24)
        ;;
        256-bit)
            key=$(openssl rand -hex 32)
        ;;
        512-bit)
            key=$(openssl rand -hex 64)
        ;;
    esac

    echo "Here is your key: $key"
    echo "Want to save it to a file?"

    saving_to_file=$(gum choose yes no)

    case $saving_to_file in
        yes)
        read -p "Enter file name:   " file
        echo -n "$key" >> $file
        ;;
        no)
        return 0
        ;;
    esac
}
aes_menu() {
    aes_options=$(gum choose Decrypt Encrypt return exit )

    case $aes_options in
        Decrypt)
            aes_decrypt
            ;;
        Encrypt)
            aes_encrypt
            ;;
        return)
            encryption_menu
            ;;
        exit)
            return 1
            ;;
    esac
}
aes_decrypt() {
    aes_decrypt_options=$(gum choose AES-128 AES-256)

    case $aes_decrypt_options in
        AES-128)
            decrypt_128
            ;;
        AES-256)
            decrypt_256
            ;;
        return)
            aes_menu
            ;;
        exit)
            return 1
            ;;
    esac
}
aes_encrypt() {
    aes_encrypt_options=$(gum choose AES-128 AES-256 return exit)

    case $aes_encrypt_options in
        AES-128)
            encrypt_128
            ;;
        AES-256)
            encrypt_256
            ;;
        return)
            aes_menu
            ;;
        exit)
            return 1
            ;;
    esac
}
encrypt_128() {
    text_or_file=$(gum choose file text return exit)

    case $text_or_file in
        file)
        echo "Enter file:   "
        file=$(gum file)

        read -p "Enter file to write to (no extension added):    " output_file

        animation_begin

        openssl enc -aes-128-cbc -pbkdf2 -iter 100000 -salt -in "$file" -out "$output_file.aes"

        animation_end

        echo "Encrypted file:   $output_file.aes" 

        echo "Delete original unencrypted file?"
        delete_choice=$(gum choose yes no)
        case $delete_choice in
            yes)
                shred -u -- "$file"
            ;;
            no)
                return 0
            ;;
        esac
        ;;
        text)
        text=$(gum write)

        printf "%s" "$text" | openssl enc -aes-128-cbc -pbkdf2 -iter 100000 -salt -a
        
        ;;
        return)
            aes_encrypt
            ;;
        exit)
            return 1
            ;;
    esac
}

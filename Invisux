# Error handling
error_check() {
    echo

    case $status in
        0)
            echo 
        ;;
        1)
            echo "Error status: "
            echo -e "${RED}[!] General/catchall error${RESET}"
        ;;
        2)
            echo "Error status: "
            echo -e "${RED}[!] Misuse of shell builtin${RESET}"
        ;;
        3)
            echo "Error status: "
            echo -e "${RED}[!] Invalid input${RESET}"
            ;;
        4)
            echo "Error status: "
            echo -e "${RED}[!] Input does not meet the requirements of the input${RESET}"
            ;;
        5)
            echo "Error status: "
            echo -e "${RED}[!] Empty input${RESET}"
            ;;
        6)
            echo "Error status: "
            echo -e "[↩] Action aborted${RESET}"
            ;;
        7)
            echo "Error status: "
            echo -e "${RED} Action failed, missing required part(s)${RESET}"
            ;;
        *)
            echo -e "${RED}[!] Unhandled exit status: $status${RESET}" >&2
        ;;
    esac
}


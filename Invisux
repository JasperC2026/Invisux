# Shared commands
BLA_classic_utf8=( 0.25 '—' '\\' '|' '/' )

declare -a BLA_active_loading_animation

BLA::play_loading_animation_loop() {
    while true; do
        for frame in "${BLA_active_animation[@]}"; do
            printf '\r%s' "$frame"
            sleep "${BLA_loading_animation_frame_interval}"
        done
    done
}

BLA::start_loading_animation() {
    BLA_active_loading_animation=( "$@" )
    BLA_loading_animation_frame_interval="${BLA_active_loading_animation[0]}"
    unset 'BLA_active_loading_animation[0]'
    tput civis
    BLA::play_loading_animation_loop &
    BLA_loading_animation_pid="$!"
}

BLA::stop_loading_animation() {
    kill "${BLA_loading_animation_pid}" &>/dev/null
    printf '\n'
    tput cnorm
}

animation_begin() {
    BLA::start_loading_animation "${BLA_classic_utf8[@]}"
}
animation_end() {
    BLA::stop_loading_animation
}
dependencie_checker() {
    if ! command -v $dependencie >/dev/null 2>&1; then
        echo "$dependencie not installed"
        echo "Install $dependencie?"
        local answer=$(gum choose yes no)

        case $answer in
            yes)
            echo "Choose package manager:   "
            local package_manager=$(gum choose apt dnf pacman)
            
            case $package_manager in
                apt)
                sudo apt install -y $dependencie 
                ;;
                dnf)
                sudo dnf install --assumeyes $dependencie
                ;;
                pacman)
                sudo pacman -S --noconfirm $dependencie 
            esac
            ;;     
            no)
            return 0
            ;;
        esac
    fi
}


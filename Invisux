generate-passwd() {
    local dependencie=openssl
    dependencie_checker

    echo "Password length: (between 8 and 128)"

    local length=$(gum input --placeholder "Password length")
    local length=${length:-16}

    if [[ ! "$length" =~ ^[0-9]+$ ]]; then
        echo "Invalid input for lenght"
        status=3
        error_check
        return 0
    fi

    if [ "$length" -ge 7 ] && [ "$length" -le 129 ]; then
        echo "You selected $length as your lenght size"
    else
        echo "You selected a lenght not supported"
        status=4
        error_check
        return 0
    fi

    local pass_alnum
    pass_alnum=$(openssl rand -base64 96 | tr -dc 'A-Za-z0-9' | head -c "$length")
    
    echo -e "  Alphanumeric : ${pass_alnum}${RESET}"

    local pass_full
    pass_full=$(openssl rand -base64 96 | tr -dc 'A-Za-z0-9!@#$%^&*()-_=+[]{}|;:,.<>?' | head -c "$length")
    
    echo -e "  With symbols : ${pass_full}${RESET}"

    local pass_hex
    pass_hex=$(openssl rand -hex 64 | head -c "$length")

    echo -e "  Hex          : ${pass_hex}${RESET}"

    echo

    local entropy_alnum entropy_full
    entropy_alnum=$(awk "BEGIN { printf \"%d\", $length * 5.954 }")
    entropy_full=$(awk  "BEGIN { printf \"%d\", $length * 6.554 }")

    echo -e "[i] Estimated entropy — alphanumeric: ~${entropy_alnum} bits  |  with symbols: ~${entropy_full} bits${RESET}"

    status=$?
    error_check
}

generate-passwd--c() {
    local dependencie=openssl
    dependencie_checker

    if [[ -z $3 ]]; then
        status=5
        error_check
        return 0
    fi

    local length=$(gum input --placeholder "Password length")
    local length=${length:-16}

    if [[ ! "$length" =~ ^[0-9]+$ ]]; then
        return 0
    fi

    if [ ! "$length" -ge 7 ] && [ "$length" -le 129 ]; then
        return 0
    fi

    local pass_alnum
    pass_alnum=$(openssl rand -base64 96 | tr -dc 'A-Za-z0-9' | head -c "$length")
    

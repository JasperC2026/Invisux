generate-key() {
    local dependencie=gpg
    dependencie_checker

    gpg --gen-key

    status=$?
    error_check
} 

delete-key() {
    local dependencie=gpg
    dependencie_checker

    read -p "Username:  " username

    echo "Enter kind of key:    "
    local answer=$(gum choose public private)

    case $answer in
        public)
            gum confirm "Delete key for: $username?" && gpg --delete-key $username 
        ;;
        private)
            gum confirm "Delete key for: $username?" && gpg --delete-secret-key $username
        ;;
    esac

    status=$?
    error_check
}

import-key() {
    local dependencie=gpg
    dependencie_checker

    echo "Select a file:    "
    local file=$(gum file)

    if [[ "$file" == "no file selected" ]]; then
        echo "No file was selected"
        status=5
        error_check
        eturn 0
    fi

    gpg --import $file

    status=$?
    error_check
} 

export-key() {
    local dependencie=gpg
    dependencie_checker

    read -p "Enter your username:   " username
    read -p "Enter file to write to (no extension added):    " file

    gpg --export -a $username $file.key

    status=$?
    error_check
} 

list-keys() {
    local dependencie=gpg
    dependencie_checker

    echo "Public:   "
    gpg --list-keys
    echo "Secret:   "
    gpg --list-secret-keys

    status=$?
    error_check
} 


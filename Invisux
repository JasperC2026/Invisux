# Error handling
error_check() {
    echo
    echo "Error status: "

    case $status in
        0)
            echo -e "${GREEN}[✔] Succes / no error${RESET}"
        ;;
        1)
            echo -e "${RED}[!] General/catchall error${RESET}"
        ;;
        2)
            echo -e "${RED}[!] Misuse of shell builtin${RESET}"
        ;;
        3)
            echo -e "${RED}[!] Invalid input${RESET}"
            ;;
        4)
            echo -e "${RED}[!] Input does not meet the requirements of the input${RESET}"
            ;;
        5)
            echo -e "${RED}[!] Empty input${RESET}"
            ;;
        6)
            echo -e "[↩] Action aborted${RESET}"
            ;;
        7)
            echo -e "${RED} Action failed, missing required part(s)${RESET}"
            ;;
        126)
            echo -e "${RED}[!] Command found but not executable${RESET}"
            ;;
        127)
            echo -e "${RED}[!] Command not found${RESET}"
            ;;
        128)
            echo -e "${RED}[!] Invalid argument to exit${RESET}"
            ;;
        128+N)
            echo -e "${RED}[!] Terminated by signal N${RESET}"
            ;;
        255)
            echo -e "${RED}[!] Exit status out of range / uncaught error${RESET}"
            ;;
        *)
            echo -e "${RED}[!] Unhandled exit status: $status${RESET}" >&2
        ;;
    esac
}

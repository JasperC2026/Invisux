steganography() {
    steg_menu=$(gum choose Embed Extract)
    case $steg_menu in
        Embed)
            local dependencie=steghide
            dependencie_checker

            echo "Enter file to hide"
            local file=$(gum file)

            if [[ "$file" == "no file selected" ]]; then
                echo "No file was selected"
                status=5
                error_check
                return 0
            fi

            echo "Enter JPG image to hide the file in"
            local jpg=$(gum file)

            if [[ "$file" == "no file selected" ]]; then
                echo "No file was selected"
                status=5
                error_check
                return 0
            fi

            echo "Enter password to encrypt with:   "
            local password=$(gum input --placeholder "Password")

            if [[ -z "$password" ]]; then
                echo "No input provided" >&2
                status=5
                error_check
                return 0
            fi

            echo "Want to save it to a file?"

            local saving_to_file=$(gum choose yes no)

            case $saving_to_file in
                yes)
                read -p "Enter file name:   " file
                echo -n "$password" >> $file
                ;;
            esac

            steghide embed -cf $jpg -ef $file "$password"

            error_check
        ;;
        Extract)
            local dependencie=steghide
            dependencie_checker

            echo "Enter file it is hidden in:   "
            local file=$(gum file)

            if [[ "$file" == "no file selected" ]]; then

generate-key() {
    gpg --gen-key
} 
delete-key() {
    read -p "Username:  " username
    echo "Enter kind of key:    "
    answer=$(gum choose public private)

    case $answer in
        public)
            gpg --delete-key $username 
        ;;
        private)
            gpg --delete-secret-key $username
        ;;
    esac
}
import-key() {
    echo "Select a file:    "
    file=$(gum file)

    gpg --import $file
} 
export-key() {
    read -p "Enter your username:   " username
    read -p "Enter file to write to (no extension added):    " file

    gpg --export -a $username $file.key
} 
list-keys() {
    echo "Public:   "
    gpg --list-keys
    echo "Secret:   "
    gpg --list-secret-keys
} 
sign() {
    echo "Select a file:    "
    file=$(gum file)

    gpg --sign $file
}
verify() {
    echo "Select a file:    "
    file=$(gum file)

	gpg --verify $file
}
help () {
    if [[ -z "$1" ]]; then
        _invisux_main_command
        return 0
    fi

    case "$1" in
        *)
            echo -e "${RED}[!] No help entry for '$1'.${RESET}"
            return 1
            ;;
    esac
}

